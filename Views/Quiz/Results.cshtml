<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Quiz Results</title>
    <style>
        body {
            background-color: #0d1117;
            color: #e6edf3;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 40px 20px;
        }


        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        h2 {
            text-align: center;
            font-size: 2rem;
            color: #58a6ff;
            margin-bottom: 10px;
        }

        .summary {
            text-align: center;
            margin-bottom: 30px;
            font-size: 1.2rem;
            color: #c9d1d9;
        }

        .question-block {
            background-color: #161b22;
            margin-bottom: 30px;
            padding: 20px;
            border-radius: 10px;
        }

        .question-block h3 {
            color: #f0f6fc;
            margin-bottom: 10px;
        }

        .split-bar {
            display: flex;
            border-radius: 6px;
            overflow: hidden;
            margin: 10px 0;
            font-size: 1rem;
        }

        .left-half {
            flex: 1;
            background-color: #7d2ae8;
            color: white;
            padding: 10px;
        }

        .right-half {
            flex: 1;
            padding: 10px;
        }

        .right-half.correct {
            background-color: #2ea043;
        }

        .right-half.incorrect {
            background-color: #f85149;
        }

        .correct-answer {
            background-color: #2ea043;
            color: white;
            padding: 10px;
            border-radius: 6px;
            margin-top: 10px;
        }

        footer {
            text-align: center;
            margin-top: 60px;
            font-size: 0.85rem;
            color: #8b949e;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Quiz Results</h2>
        <p class="summary">
            You answered <strong>@((ViewBag.CorrectCount is not null && ViewBag.CorrectCount != false) ? ViewBag.CorrectCount : 0)</strong> out of <strong>@ViewBag.TotalQuestions</strong> correctly (<strong>@ViewBag.Percentage%</strong>).
        </p>

        @for (int i = 0; i < ViewBag.Questions.Count; i++)
        {
            var question = ViewBag.Questions[i];
            var userAnswer = ViewBag.GivenAnswersText[i];
            var correctAnswer = ViewBag.CorrectAnswersText[i];
            bool isCorrect = userAnswer == correctAnswer;

            <div class="question-block">
                <h3>@question.Text</h3>

                <div class="split-bar">
                    <div class="left-half">@userAnswer</div>
                    <div class="right-half @(isCorrect ? "correct" : "incorrect")"></div>
                </div>

                
                @if(!isCorrect){
                    <div class="correct-answer">
                        <strong>Correct answer:</strong> @correctAnswer
                    </div>
                }
                
            </div>
        }

        @if (ViewBag.Subject == "Matematica"){
            <a asp-controller="Matematica" asp-action="Index" class="btn btn-primary text-center">
                Întoarce-te la mindmap @ViewBag.Subject
            </a>
        }else{
            <a asp-controller="Informatica" asp-action="Index" class="btn btn-primary text-center">
                Întoarce-te la mindmap @ViewBag.Subject
            </a>
        }
        
    </div>

    <footer>
        © 2025 BacPeBune – Recapitulare completă
    </footer>
</body>
</html>

