<h2>Quiz Results</h2>
<p>You answered <strong>@ViewBag.CorrectCount</strong> out of <strong>@ViewBag.TotalQuestions</strong> correctly (<strong>@ViewBag.Percentage%</strong>).</p>

@foreach(var item in ViewBag.Questions){
    <h3>@item.Text</h3>
}

@foreach(var item in ViewBag.GivenAnswersText){
    <p style="background-color:purple;">Your answer: @item</p>
}

@foreach(var item in ViewBag.CorrectAnswersText){
    <p style="background-color:green;">Correct answer: @item</p>
}

