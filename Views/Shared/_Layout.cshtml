<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BacPeBune</title>

    <!-- Stiluri -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BacPeBune.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>

<body style="margin: 0; padding: 0; overflow-x: hidden;">

    <!-- Navbar Sticky -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-white" href="/" style="font-size: 1.8rem; font-family: Montserrat;">
                BacPeBune
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav d-flex align-items-center gap-2">
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Acasă</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Matematica" asp-action="Index">Matematică</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Informatica" asp-action="Index">Informatică</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Magazin" asp-action="Index">Magazin</a></li>
                    <li class="nav-item">
                        <partial name="_LoginPartial" />
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Conținut pagină -->

    @RenderBody()

    <footer class="footer text-white text-center py-3 mt-0" style="background-color: #0f172a; border: none;">
    <div class="container">
        <p class="mb-0">&copy; 2025 BacPeBune. Toate drepturile rezervate.</p>
    </div>
</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
