<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BacPeBune</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BacPeBune.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg bg-white shadow-sm">
        <div class="container">
            <h2 class="navbar-brand m-0 mx-auto fw-bold text-primary" style="font-size: 2rem; font-family: Montserrat;">BAC Smart Learning</h2>
            <ul class="navbar-nav ms-auto d-flex flex-row align-items-center gap-2">
            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Acasă</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Matematica" asp-action="Index">Matematică</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Informatica" asp-action="Index">Informatică</a></li>
            <partial name = "_LoginPartial" />
            </ul>
        </div>
    </nav>
   
    @RenderBody()
        

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BacPeBune</a>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
