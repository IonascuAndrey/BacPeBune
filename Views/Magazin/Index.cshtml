@{
    ViewData["Title"] = "Magazin";
    var puncte = ViewBag.Puncte ?? 123;
}

<style>
    body {
        background: linear-gradient(to bottom right, #0f172a, #1e3a8a);
        background-attachment: fixed;
        background-size: cover;
        font-family: 'Montserrat', sans-serif;
    }

    h2 {
        text-align: center;
        margin-bottom: 10px;
        color: #ffffff;
        font-size: 2rem;
        text-shadow: 0 0 6px rgba(255, 255, 255, 0.2);
    }

    .puncte-bar {
        text-align: center;
        font-weight: bold;
        margin-top: 10px;
        color: #facc15;
        font-size: 1.2rem;
        text-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
    }

    .magazin-grid {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 40px;
        padding: 40px 20px;
        margin-bottom: 120px;
    }

    .product-card {
        color: white;
        border-radius: 16px;
        padding: 25px;
        width: 300px;
        text-align: center;
        box-shadow: 0 0 15px rgba(0, 150, 255, 0.3);
        transition: transform 0.2s ease;
        border: 1px solid #2a2a3f;
    }

    .product-card:nth-child(odd) {
        background-color: #1e1e2f;
    }

    .product-card:nth-child(even) {
        background-color: #223344;
    }

    .product-card:hover {
        transform: scale(1.02);
    }

    .icon-wrapper {
        margin-bottom: 16px;
    }

    .price {
        font-weight: bold;
        margin: 12px 0;
    }

    .buy-button {
        background-color: #007bff;
        color: white;
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .buy-button:hover {
        background-color: #0056b3;
    }
</style>

<h2>Magazinul Elevului 🛒</h2>
<div class="puncte-bar">
    Ai <strong>@puncte puncte</strong> disponibile
</div>

<div class="magazin-grid">
    <div class="product-card">
        <div class="icon-wrapper">
            <img src="/img/coin.png" alt="Coin" width="40" />
        </div>
        <h3>Test de antrenament</h3>
        <p>Exerciții simulate din Bacalaureat, cu barem complet și corectare automată.</p>
        <p class="price">Cost: 100 puncte</p>
        <button class="buy-button">Cumpără</button>
    </div>

    <div class="product-card">
        <div class="icon-wrapper">
            <img src="/img/coin.png" alt="Coin" width="40" />
        </div>
        <h3>Fișă recapitulativă</h3>
        <p>PDF cu sinteze pentru capitole esențiale din matematică și informatică.</p>
        <p class="price">Cost: 75 puncte</p>
        <button class="buy-button">Cumpără</button>
    </div>

    <div class="product-card">
        <div class="icon-wrapper">
            <img src="/img/coin.png" alt="Coin" width="40" />
        </div>
        <h3>Meditatie online particulară</h3>
        <p>Sesiune individuală online cu profesor specializat. Durată: 60 minute.</p>
        <p class="price">Cost: 500 puncte</p>
        <button class="buy-button">Cumpără</button>
    </div>

    <div class="product-card">
        <div class="icon-wrapper">
            <img src="/img/coin.png" alt="Coin" width="40" />
        </div>
        <h3>Meditatie online în grup</h3>
        <p>Grup restrâns, predare interactivă, teme comune. Durată: 90 minute.</p>
        <p class="price">Cost: 300 puncte</p>
        <button class="buy-button">Cumpără</button>
    </div>

    <div class="product-card">
        <div class="icon-wrapper">
            <img src="/img/coin.png" alt="Coin" width="40" />
        </div>
        <h3>Set de întrebări tip grilă</h3>
        <p>25 de întrebări selectate pe baza parcurrsului de până acum, cu explicații și scor final.</p>
        <p class="price">Cost: 60 puncte</p>
        <button class="buy-button">Cumpără</button>
    </div>

    <div class="product-card">
        <div class="icon-wrapper">
            <img src="/img/coin.png" alt="Coin" width="40" />
        </div>
        <h3>Acces premium 7 zile</h3>
        <p>Acces complet la lecții, teste exclusive și rapoarte de progres.</p>
        <p class="price">Cost: 200 puncte</p>
        <button class="buy-button">Cumpără</button>
    </div>
</div>
