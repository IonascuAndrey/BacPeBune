</section>

<!-- SignalR Client Script -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

    const chatHistory = document.getElementById("chat-history");
    const messageInput = document.getElementById("messageInput");
    const sendButton = document.getElementById("sendButton");
    const emptyState = document.getElementById("empty-state");
    let currentAiMessageDiv = null;

    connection.on("ReceiveMessageChunk", (chunk) => {
        if (!currentAiMessageDiv) {
            const wrapper = document.createElement("div");
            wrapper.className = "d-flex mb-3";
            wrapper.innerHTML = `
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width: 32px; height: 32px;"><i class="bi bi-robot"></i></div>
                <div class="bg-white p-3 rounded shadow-sm border" style="max-width: 80%;">
                    <div class="content text-dark"></div>
                </div>`;
            chatHistory.appendChild(wrapper);
            currentAiMessageDiv = wrapper.querySelector(".content");
        }
        currentAiMessageDiv.innerHTML += chunk.replace(/\n/g, "<br>");
        chatHistory.scrollTop = chatHistory.scrollHeight;
    });

    connection.on("ReceiveMessageDone", () => {
        currentAiMessageDiv = null;
        messageInput.disabled = false;
        sendButton.disabled = false;
        messageInput.focus();
    });

    async function start() {
        try { await connection.start(); console.log("SignalR Connected."); } 
        catch (err) { console.error(err); setTimeout(start, 5000); }
    }

    sendButton.addEventListener("click", async () => {
        const msg = messageInput.value;
        if (!msg) return;
        if(emptyState) emptyState.style.display = 'none';
        
        const userDiv = document.createElement("div");
        userDiv.className = "d-flex mb-3 justify-content-end";
        userDiv.innerHTML = `
            <div class="bg-primary text-white p-3 rounded shadow-sm" style="max-width: 80%;">${msg}</div>
        `;
        chatHistory.appendChild(userDiv);
        chatHistory.scrollTop = chatHistory.scrollHeight;

        messageInput.value = "";
        messageInput.disabled = true;
        sendButton.disabled = true;

        try { await connection.invoke("SendMessage", msg); } 
        catch (err) { console.error(err); messageInput.disabled = false; sendButton.disabled = false; }
    });

    messageInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter" && !sendButton.disabled) sendButton.click();
    });

    start();
</script>

