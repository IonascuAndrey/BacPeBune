@model BacPeBune.Models.Lesson

@{
    ViewBag.Title = @Model.Title;
}

<div class="lesson-box">
    <h1>@Model.Title</h1>

    <iframe src="@Model.PdfLink" width="100%" height="600px"></iframe>



    @if(ViewBag.quizID != null){
        <a href="@Url.Action("Show", "Quiz", new { quizId = ViewBag.quizID })" width="100%" height="600px">Acceseaza quiz-ul</a>
    }
    else{
        <p class="no-quiz">Nu există un quiz asociat acestei lecții.</p>
    }
</div>

