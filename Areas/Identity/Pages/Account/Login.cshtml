@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(to right, #0f3f7f, #95a5a6); /* albastru-gri */
        font-family: 'Montserrat', sans-serif;
        padding: 2rem;
    }

    .login-card {
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        max-width: 1000px;
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .login-card:hover {
        transform: scale(1.02);
        box-shadow: 0 0 30px rgba(255, 255, 255, 0.5);
    }

    .login-form {
        padding: 40px;
        flex: 1 1 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-image {
        flex: 1 1 50%;
        background: url('/img/login.png') center center/cover no-repeat;
        min-height: 400px;
    }

    .form-floating label {
        color: #0f3f7f;
    }

    .btn-primary {
        background-color: #0f3f7f;
        border-color: #0f3f7f;
    }

    .btn-primary:hover {
        background-color: #0c3262;
        border-color: #0c3262;
    }

    .text-link a {
        color: #0f3f7f;
        text-decoration: underline;
    }
</style>

<div class="login-container">
    <div class="login-card">
        <div class="login-form">
            <h2 class="fw-bold mb-4 text-center text-uppercase text-primary">Autentificare</h2>
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Parolă" />
                    <label asp-for="Input.Password">Parolă</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label>
                        <input asp-for="Input.RememberMe" /> @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Autentifică-te</button>
            </form>
            <div class="mt-3 text-center text-link">
                <p>Nu ai un cont? <a asp-area="Identity" asp-page="/Account/Register">Creează unul</a></p>
            </div>
        </div>
        <div class="login-image"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
